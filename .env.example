# Lazy Lizard Agent — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it contains private keys and secrets.

# ─── Solana Wallet ───────────────────────────────────────────────────────────
# Your wallet's base58-encoded private key. Keep this SECRET.
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Solana RPC endpoint (mainnet-beta, or a paid provider for better rate limits)
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ─── Trading Parameters ───────────────────────────────────────────────────────
# Take-profit percentage (default 5.0 = +5%)
TAKE_PROFIT_PCT=5.0

# Maximum SOL to spend per position
MAX_POSITION_SOL=0.1

# Minimum number of veteran wallets required in the first 15 buyers
VETERAN_WALLET_MIN=1

# ─── ERC-8004 Reputation ─────────────────────────────────────────────────────
# Minimum cohort reputation score (0-100) required to trigger a buy
MIN_REPUTATION_SCORE=70

# ─── x402 Donations ──────────────────────────────────────────────────────────
# Percentage of profit to donate via x402 (0 to disable)
X402_DONATE_PCT=1.0

# ─── Telegram Alerts ─────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get these values.
# See docs/TELEGRAM-BOT.md for detailed setup instructions.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Safety ──────────────────────────────────────────────────────────────────
# Set to "true" to simulate without executing real transactions (recommended initially)
DRY_RUN=true
