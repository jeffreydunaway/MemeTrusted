# Lazy Lizard Agent — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit your .env file — it contains secrets.

# ─────────────────────────────────────────────────────────────
# Solana RPC
# ─────────────────────────────────────────────────────────────
# Public free endpoints (rate-limited):
#   https://api.mainnet-beta.solana.com
# Recommended paid endpoints: Helius, QuickNode, Triton
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────────────────────
# Wallet — KEEP THESE SECRET
# ─────────────────────────────────────────────────────────────
# Base58-encoded private key of your trading wallet.
# Use a dedicated hot wallet funded with only what you risk.
WALLET_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# Trading parameters
# ─────────────────────────────────────────────────────────────
# Set to "true" for paper-trading (no real transactions)
DRY_RUN=true

# Take-profit percentage as decimal (0.05 = 5%)
TAKE_PROFIT_PCT=0.05

# SOL amount per trade
POSITION_SIZE_SOL=0.01

# Jupiter slippage tolerance in basis points (100 = 1%)
SLIPPAGE_BPS=100

# ─────────────────────────────────────────────────────────────
# Signal filters
# ─────────────────────────────────────────────────────────────
# Minimum number of veteran wallets required in first-N buyers
MIN_VETERAN_WALLETS=2

# Number of early buyers to analyse (first-N window)
FIRST_N_BUYERS=15

# Seconds between each poll cycle
POLL_INTERVAL_SECONDS=30

# ─────────────────────────────────────────────────────────────
# Telegram alerts (optional)
# ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=

# Your personal chat ID or a group/channel chat ID
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# x402 micro-donation (optional)
# ─────────────────────────────────────────────────────────────
# Recipient address for x402 protocol micro-fees
X402_RECIPIENT_ADDRESS=

# Donation amount per successful trade (in SOL)
X402_DONATION_SOL=0.0001

# ─────────────────────────────────────────────────────────────
# ERC-8004 agent reputation (optional)
# ─────────────────────────────────────────────────────────────
ERC8004_CONTRACT_ADDRESS=
ERC8004_AGENT_ID=

# ─────────────────────────────────────────────────────────────
# Diamond proxy treasury (optional)
# ─────────────────────────────────────────────────────────────
DIAMOND_PROXY_ADDRESS=
